{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/open-telemetry/opentelemetry-announcements/schema/config.schema.json",
  "title": "OpenTelemetry announcements configuration",
  "description": "How merged announcements are delivered, and to which destinations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "targets"],
  "properties": {
    "mode": {
      "enum": ["check", "draft", "publish"],
      "description": "Mode for merged announcements: check (preview only), draft (drafts in Buffer and Groups.io, Slack previewed only) or publish."
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "description": "Destinations per channel, by name. Announcements can skip a channel or a single destination by its name. A destination is an ID, or an object with the ID and an opt_in note for destinations that only get announcements that include them.",
      "properties": {
        "bluesky": { "$ref": "#/$defs/buffer" },
        "mastodon": { "$ref": "#/$defs/buffer" },
        "linkedin": { "$ref": "#/$defs/buffer" },
        "slack": {
          "$ref": "#/$defs/destinations",
          "description": "Slack channel IDs (not names), for example C0123456789.",
          "additionalProperties": {
            "anyOf": [
              { "$ref": "#/$defs/slackId" },
              { "$ref": "#/$defs/optIn", "properties": { "id": { "$ref": "#/$defs/slackId" } } }
            ]
          }
        },
        "groupsio": {
          "$ref": "#/$defs/destinations",
          "description": "Group IDs on lists.cncf.io.",
          "additionalProperties": {
            "anyOf": [
              { "$ref": "#/$defs/groupId" },
              { "$ref": "#/$defs/optIn", "properties": { "id": { "$ref": "#/$defs/groupId" } } }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "description": "A string without whitespace. Quote names and IDs that YAML would read as numbers.",
      "type": "string",
      "not": { "type": "string", "pattern": "\\s" }
    },
    "destinations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "buffer": {
      "$ref": "#/$defs/destinations",
      "description": "Buffer channel IDs (not organization IDs), one per service.",
      "additionalProperties": {
        "anyOf": [
          { "$ref": "#/$defs/bufferId" },
          { "$ref": "#/$defs/optIn", "properties": { "id": { "$ref": "#/$defs/bufferId" } } }
        ]
      }
    },
    "bufferId": { "$ref": "#/$defs/id", "pattern": "^[A-Za-z0-9_-]+$" },
    "slackId": { "$ref": "#/$defs/id", "pattern": "^[CG][A-Z0-9]+$" },
    "groupId": { "type": "integer", "minimum": 1 },
    "optIn": {
      "type": "object",
      "description": "An opt-in destination: announcements are only sent to it when they include it.",
      "additionalProperties": false,
      "required": ["id", "opt_in"],
      "properties": {
        "id": { "description": "The ID of the destination." },
        "opt_in": {
          "type": "string",
          "pattern": "\\S",
          "description": "What the destination is for. Shown as a warning when an announcement includes it."
        }
      }
    }
  }
}
